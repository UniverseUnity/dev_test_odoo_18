<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.supplier.sync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='barcode_setting_container']" position="after">
                <block title="Supplier Sync" name="supplier_sync_setting_container">
                    <setting string="Supplier Feed Path" help="Path or URL to the supplier feed JSON">
                        <field name="supplier_feed_path" readonly="0"/>
                    </setting>
                    <setting string="Webhook Token" help="Token for real-time price updates">
                        <field name="supplier_webhook_token" readonly="0"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
